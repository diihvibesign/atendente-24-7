{
  "name": "@atendente/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --external:pg --external:fastify --external:@fastify/* --external:otpauth --outfile=dist/server.js",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atendente/contracts": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "fastify": "5.12.5",
    "otpauth": "9.5.0",
    "pg": "8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
