# Valores abaixo são exclusivos de desenvolvimento local. setup:local cria .env ignorado.
DATABASE_URL=postgresql://atendente_app:local_app_only@localhost:55432/atendente
MIGRATION_DATABASE_URL=postgresql://atendente_owner:local_owner_only@localhost:55432/atendente
TEST_DATABASE_URL=postgresql://atendente_app:local_app_only@localhost:55433/atendente_test
TEST_MIGRATION_DATABASE_URL=postgresql://atendente_owner:local_owner_only@localhost:55433/atendente_test
APP_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:3001
API_PORT=3001
MFA_ENCRYPTION_KEY=
# Credenciais de telefonia/cobrança serão utilizadas nas próximas fases, via adaptadores.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VOICE_AI_API_KEY=
# Alternativa para a prova de voz com ElevenLabs Agents; OpenAI pode ficar vazio.
ELEVENLABS_API_KEY=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Habilitar somente para testar o recebimento no sandbox após configurar token/HTTPS.
ASAAS_WEBHOOK_ENABLED=false
