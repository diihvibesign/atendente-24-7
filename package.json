{
  "name": "atendente-24-7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter @atendente/api build && pnpm --filter @atendente/web build",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:demo": "tsx scripts/demo.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "access:reset": "tsx scripts/reset-access.ts",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.58.2",
    "@types/node": "24.12.0",
    "@types/pg": "8.16.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "pg": "8.20.0",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vitest": "4.1.11"
  }
}
